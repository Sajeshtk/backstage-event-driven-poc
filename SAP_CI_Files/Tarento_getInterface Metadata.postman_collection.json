  },
  "item": [
    {
      "name": "1) Get Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let json = pm.response.json();\r",
              "\r",
              "pm.test(\"Token request successful\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "    pm.expect(json).to.have.property(\"access_token\");\r",
              "});\r",
              "\r",
              "// Store access token as collection variables\r",
              "//pm.collectionVariables.set(\"btp_access_token\", json.access_token);\r",
              "//pm.collectionVariables.set(\"btp_token_type\", json.token_type || \"Bearer\");\r",
              "//pm.collectionVariables.set(\"btp_expires_in\", json.expires_in);\r",
              "\r",
              "// Optional: ready-made Authorization header\r",
              "pm.collectionVariables.set(\r",
              "    \"btp_auth_header\",\r",
              "    `${json.token_type || \"Bearer\"} ${json.access_token}`\r",
              ");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            },
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{tokenHost}}/oauth/token?grant_type=client_credentials",
          "host": [
            "{{tokenHost}}"
          ],
          "path": [
            "oauth",
            "token"
          ],
          "query": [
            {
              "key": "grant_type",
              "value": "client_credentials"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "2) Get interfaces",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let response = pm.response.json();\r",
              "\r",
              "let flows = response.d.results.map(item => ({\r",
              "    id: item.Id,\r",
              "    name: item.Name,\r",
              "    packageId: item.PackageId\r",
              "}));\r",
              "console.log(flows)\r",
              "pm.environment.set(\"iflow_list\", JSON.stringify(flows));\r",
              "pm.environment.set(\"current_index\", 0);\r",
              "\r",
              "console.log(\"Total iFlows:\", flows.length);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
